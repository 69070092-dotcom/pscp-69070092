"""หาจำนวนเฉพาะ"""
start, end = map(int, input().split())

total = 0

for num in range(start, end + 1):
    if num < 2:
        continue

    prime = True

    for i in range(2, num):
        if num % i == 0:
            prime = False
            break

    if prime:
        print(num, end=" ")
        total += 1

print()
print("Total primes:", total)
