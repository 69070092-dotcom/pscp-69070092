"""Dupe 1"""
m = int(input())
n = int(input())

group1 = set()
group2 = set()

for _ in range(m):
    group1.add(int(input()))

for _ in range(n):
    group2.add(int(input()))

same = group1 & group2

if not same:
    print("Nope")
else:
    for student in sorted(same, reverse=True):
        print(student)
