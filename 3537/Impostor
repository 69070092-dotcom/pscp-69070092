"""Imposter"""
crew = {}

while True:
    line = input()
    if line == "Start":
        break

    line = line.replace("{", "").replace("}", "").replace('"', "").replace("'", "")
    for item in line.split(","):
        if ":" in item:
            name, role = item.split(":")
            crew[name.strip()] = role.strip()

dead = {}

while True:
    line = input()
    if line == "End":
        break

    for name in line.split():
        if name in crew:
            dead[name] = crew.pop(name)

count = 0
for role in crew.values():
    if role == "Impostor":
        count += 1

print(count, "Impostor Remains")
print("***Alive***")

for name in sorted(crew):
    print(name, ":", crew[name])

print("***Dead***")

for name in sorted(dead):
    print(name, ":", dead[name])
